<view wx:if="{{detailCourses.length}}" class="modal-mask" bindtap="closeDetail"><view class="detail-sheet" catchtap="stop"><view class="row"><view class="sheet-title">课程详情</view><button class="close-button" bindtap="closeDetail">关闭 ×</button></view><scroll-view scroll-y="true" class="detail-scroll"><view wx:for="{{detailCourses}}" wx:key="uid" class="detail-item"><view class="course">{{item.name}}</view><view class="time">{{item.time}} · {{item.period}}</view><view class="muted">教室：{{item.room}}</view><view class="muted">校区：{{item.campus}} · 教师：{{item.teacher}}</view><view class="muted">教学周：{{item.weeks}}</view><view wx:if="{{item.adjusted}}" class="muted">原课程日期：{{item.origin}} · 本次已调整</view><view wx:if="{{item.conflict}}" class="notice">课程时间重叠，请向教师确认实际安排。</view><button class="primary" data-uid="{{item.uid}}" bindtap="editCourse">调整 / 取消本次课程</button></view></scroll-view></view></view>
