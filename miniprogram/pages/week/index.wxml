<view class="page"><view class="personal-head"><view class="personal-name">黑背雪<text class="personal-dot">.</text></view><view class="muted">把一周看清楚</view></view><view class="eyebrow">WEEKLY SCHEDULE</view><view class="title">整周课表</view><picker mode="date" value="{{anchor}}" bindchange="pick"><view class="muted">{{anchor}} — {{weekEnd}} ▾</view></picker><view class="row nav"><button bindtap="prev">← 上周</button><button bindtap="reset">本周</button><button bindtap="next">下周 →</button></view>
 <view class="week-grid"><view class="grid-head"><view class="axis-heading">节次</view><view wx:for="{{days}}" wx:key="date" class="grid-day-head {{item.isToday ? 'today-column' : ''}}"><view>{{item.label}}</view><view class="grid-date">{{item.day}}</view></view></view><view class="grid-body"><view class="time-axis"><view wx:for="{{periods}}" wx:key="number" class="axis-slot"><view>{{item.number}}</view><view class="axis-time">{{item.time}}</view></view></view><view wx:for="{{days}}" wx:for-item="day" wx:key="date" class="day-column {{day.isToday ? 'today-column' : ''}}"><view wx:for="{{periods}}" wx:key="number" class="grid-line"></view><view wx:for="{{day.groups}}" wx:key="id" class="grid-course" style="top:{{item.top}}rpx;height:{{item.height}}rpx;background:{{item.color}}" data-date="{{day.date}}" data-group="{{item.id}}" bindtap="detail" hover-class="tap-feedback"><view class="grid-course-name">{{item.name}}</view><view class="grid-room">{{item.room}}</view><view wx:if="{{item.count > 1}}" class="grid-conflict">!</view></view></view></view></view>
 <view class="muted grid-tip">同一课程固定颜色 · 点课程查看详情与调整</view><view class="notice">跨9月与10月时，左侧时间以周一作息为参考；每门课的实际时间请点开查看。</view><view wx:for="{{days}}" wx:key="date"><view wx:if="{{item.notice}}" class="calendar-note"><text>{{item.date}} · </text>{{item.notice}}</view></view><view class="footer">黑背雪 · 个人课表</view><include src="../../templates/detail.wxml"/></view>
