<view class="page"><view class="personal-head"><view class="personal-name">黑背雪<text class="personal-dot">.</text></view><view class="muted">让安排跟上变化</view></view><view class="eyebrow">SCHEDULE SETTINGS</view><view class="title">课表设置</view><view class="muted">2026年9月14日起 · 2027年1月8日上课结束</view>
 <view wx:if="{{lastSavedDate}}" class="saved-panel"><view class="saved-title">安排已保存</view><view class="muted">{{lastSavedDate}} 的课表已更新</view><button class="secondary" bindtap="viewSaved">查看调整后的课程 →</button></view>
 <view class="group-head row" data-section="single" bindtap="toggleGroup" hover-class="tap-feedback"><view class="group-title">单门课程调整</view><view class="group-action">{{groups.single ? '收起 −' : '展开 +'}}</view></view>
 <block wx:if="{{groups.single}}"><view class="card group-body"><view class="muted">原课程日期</view><picker mode="date" value="{{editDate}}" start="2026-09-14" end="2027-01-08" bindchange="editDate"><view class="field">{{editDate}} ▾</view></picker><picker wx:if="{{options.length}}" range="{{courseNames}}" value="{{courseIndex}}" bindchange="course"><view class="field">{{courseNames[courseIndex]}} ▾</view></picker><view wx:else class="notice">原日期无课程，请选择实际有课的日期。</view><block wx:if="{{selectedCourse}}"><picker range="{{actions}}" value="{{action}}" bindchange="action"><view class="field">{{actions[action]}} ▾</view></picker><block wx:if="{{action === 0}}"><view class="muted">实际上课日期（只换教室时保持原日期）</view><picker mode="date" value="{{target}}" start="2026-09-14" end="2027-01-08" bindchange="target"><view class="field">{{target}} ▾</view></picker><view class="row"><picker class="period-picker" range="{{periodOptions}}" value="{{startIndex}}" bindchange="start"><view class="field">{{periodOptions[startIndex]}} 起 ▾</view></picker><picker class="period-picker" range="{{periodOptions}}" value="{{endIndex}}" bindchange="end"><view class="field">{{periodOptions[endIndex]}} 止 ▾</view></picker></view><input class="field" value="{{room}}" bindinput="room" maxlength="60" placeholder="教室名称"/></block><view class="muted">仅影响这一次上课，其他教学周保持原安排。</view><button class="primary" bindtap="saveCourse">保存单门调整</button></block></view></block>
 <view class="group-head row" data-section="records" bindtap="toggleGroup" hover-class="tap-feedback"><view class="group-title">单门调整记录 <text class="group-count">{{courseRules.length}}</text></view><view class="group-action">{{groups.records ? '收起 −' : '展开 +'}}</view></view>
 <block wx:if="{{groups.records}}"><view wx:if="{{!courseRules.length}}" class="card muted">暂无单门调整</view><view wx:for="{{courseRules}}" wx:key="key" class="card"><view class="course">{{item.name}}</view><view class="muted">原日期：{{item.source}}</view><view class="muted">{{item.type === 'cancel' ? '本次已取消' : '调至 ' + item.target + ' · 第' + item.start + '—' + item.end + '节'}}</view><view wx:if="{{item.type === 'move'}}" class="muted">{{item.room}}</view><button class="danger" data-key="{{item.key}}" bindtap="removeCourse">恢复原安排</button></view></block>
 <view class="group-head row" data-section="day" bindtap="toggleGroup" hover-class="tap-feedback"><view class="group-title">整天调整 <text class="group-count">{{rules.length}}</text></view><view class="group-action">{{groups.day ? '收起 −' : '展开 +'}}</view></view>
 <block wx:if="{{groups.day}}"><view class="card"><view class="muted">需要调整的实际日期</view><picker mode="date" value="{{date}}" bindchange="date"><view class="field">{{date}} ▾</view></picker><picker range="{{types}}" value="{{type}}" bindchange="type"><view class="field">{{types[type]}} ▾</view></picker><block wx:if="{{type === 1}}"><view class="muted">套用原课程日的教学周和星期，作息使用实际上课日的时间。</view><picker mode="date" value="{{source}}" start="2026-09-14" end="2027-01-08" bindchange="source"><view class="field">{{source}} ▾</view></picker></block><input wx:else class="field" placeholder="原因，例如班级通知停课" value="{{note}}" bindinput="note" maxlength="60"/><button class="primary" bindtap="save">保存整天安排</button><view class="muted">整天停课会隐藏当天所有课程，包括调入的课程。</view></view><view wx:for="{{rules}}" wx:key="date" class="card"><view>{{item.date}}</view><view class="muted">{{item.type === 'off' ? item.note : '按 ' + item.source + ' 的课程'}}</view><button class="danger" data-date="{{item.date}}" bindtap="remove">删除整天调整</button></view></block>
 <view class="group-head row" data-section="times" bindtap="toggleGroup" hover-class="tap-feedback"><view class="group-title">当前作息</view><view class="group-action">{{groups.times ? '收起 −' : '展开 +'}}</view></view><view wx:if="{{groups.times}}" class="card"><view wx:for="{{times}}" wx:key="period" class="row muted"><view>第{{item.period}}节</view><view>{{item.time}}</view></view></view>
 <view class="group-head row" data-section="backup" bindtap="toggleGroup" hover-class="tap-feedback"><view class="group-title">备份与恢复</view><view class="group-action">{{groups.backup ? '收起 −' : '展开 +'}}</view></view>
 <view wx:if="{{groups.backup}}" class="card"><view class="course">给个人调整留一份备份</view><view class="muted">备份本学期的整天和单门调整。内置原课表随小程序保留，不会自动上传。</view><button class="primary" bindtap="exportBackup">复制备份文本</button><button class="secondary" bindtap="shareBackup">分享 JSON 备份文件</button><view class="backup-divider"></view><view class="course">从备份恢复</view><view class="muted">可从微信聊天中选择之前保存的 JSON 文件，或粘贴备份文本。恢复前会显示记录数并请你确认。</view><button class="secondary" bindtap="importFile">从聊天选择备份文件</button><textarea class="backup-input" maxlength="300000" value="{{backupText}}" bindinput="backupInput" placeholder="在这里粘贴备份文本，也可长按复制导出的文本"/><view class="row backup-actions"><button class="secondary" bindtap="pasteBackup">读取剪贴板</button><button class="primary" bindtap="importText">校验并恢复</button></view><button wx:if="{{hasUndoImport}}" class="danger" bindtap="undoBackup">撤销最近一次导入</button><view class="muted">只有保存到本机以外的文件或文本，才能在清缓存或换手机后恢复。撤销导入仅保留最近一次导入前的数据。</view></view>
 <view class="notice">校历已内置假期和补课。运动会仅提示，请根据实际通知调整。</view><view class="muted">更换设备或清缓存前，请先导出并保存备份。</view><view class="footer">黑背雪 · 个人课表</view></view>
