<view class="page">
 <view class="personal-head"><view class="personal-name">黑背雪<text class="personal-dot">.</text></view><view class="muted">我的每日课表</view></view>
 <view class="row heading-row"><view><view class="eyebrow">DAILY SCHEDULE</view><view class="title">{{isToday ? '今天' : '每日课程'}}</view></view><button class="back-today" bindtap="reset">回到今天</button></view>
 <view class="row date-heading"><picker mode="date" value="{{date}}" bindchange="pick"><view>{{date}} ▾</view></picker><view class="muted">{{inTerm ? '第 ' + week + ' 周' : '学期外'}} · {{season}}</view></view>
 <view class="date-strip"><view wx:for="{{dates}}" wx:key="date" class="date-chip {{item.selected ? 'selected' : ''}} {{item.isToday ? 'actual-today' : ''}}" data-date="{{item.date}}" bindtap="selectDate"><view class="date-label">{{item.label}}</view><view class="date-number">{{item.day}}</view><view class="today-mark">{{item.isToday ? '今天' : ' '}}</view></view></view>
 <view class="focus-card" bindtap="focusDetail" hover-class="tap-feedback"><view class="row"><view class="focus-label">{{focusTitle}}</view><view wx:if="{{isToday && focus.state === 'next'}}" class="countdown">{{focus.minutes}} 分钟后</view><view wx:elif="{{isToday && focus.state === 'current'}}" class="countdown">{{focus.minutes}} 分钟后下课</view></view><block wx:if="{{focusCourse}}"><view class="focus-name">{{focusCourse.name}}</view><view class="focus-place">{{focusCourse.room}} · {{focusCourse.campus}}校区</view><view class="focus-time">{{focusCourse.time}} · {{focusCourse.period}}</view><view wx:if="{{focus.courses.length > 1}}" class="focus-warning">同时有 {{focus.courses.length}} 门课程，请点开核实</view></block><block wx:else><view class="focus-name">{{focus.state === 'done' ? '今天辛苦了' : '留一点时间给自己'}}</view><view class="focus-place">{{notice || '明日安排已为你备好'}}</view></block></view>
 <view wx:if="{{notice && courses.length}}" class="notice">{{notice}}</view>
 <view class="row section-row"><view class="section">当日课程</view><view class="muted">共 {{courses.length}} 门 · 点击查看详情</view></view>
 <view wx:if="{{!courses.length}}" class="card empty"><view class="muted">{{notice || '这一天没有安排课程'}}</view></view>
 <view wx:for="{{courses}}" wx:key="uid" class="card course-card compact-course" style="border-left-color:{{item.color}}" data-uid="{{item.uid}}" bindtap="showDetail" hover-class="tap-feedback"><view class="row"><view class="time">{{item.time}}</view><view class="status {{item.status === '上课中' ? 'live' : ''}}">{{item.status}}</view></view><view class="course">{{item.name}}</view><view class="muted">{{item.room}} · {{item.period}}</view><view class="row tags"><view wx:if="{{item.adjusted}}" class="tag">已调整</view><view wx:if="{{item.conflict}}" class="badge">时间冲突 · 点开核实</view></view></view>
 <view class="tomorrow-card" bindtap="tomorrow"><view class="row"><view class="tomorrow-label">明日预告</view><view class="muted">{{tomorrowDate}} →</view></view><view class="course">{{tomorrowCount ? tomorrowCount + ' 门课程 · ' + tomorrowName : '明天无课'}}</view><view wx:if="{{tomorrowNotice}}" class="muted">{{tomorrowNotice}}</view></view>
 <view class="pending-head row" bindtap="pendingToggle"><view>待安排课程 · {{pending.length}} 门</view><view>{{showPending ? '收起 −' : '展开 +'}}</view></view><block wx:if="{{showPending}}"><view wx:for="{{pending}}" wx:key="name" class="card"><view class="course">{{item.name}}</view><view class="muted">{{item.detail}}</view></view></block>
 <view class="footer">黑背雪 · 个人课表</view>
 <include src="../../templates/detail.wxml"/>
</view>
